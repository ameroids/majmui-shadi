# Copy this file to .env and fill in your Supabase project's values to
# switch the app from demo mode to a live database.
# Until these are set, Majmui Shaadi runs entirely on demo data stored
# in the browser (see src/lib/db.js), so no setup is required to try it.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
